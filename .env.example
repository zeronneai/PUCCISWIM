# ─── PUCCII Swim · environment ───────────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Vercel for production.

# Public site URL, no trailing slash. Used for Stripe success/cancel + OG.
# Local: http://localhost:3000   Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe (payment) ────────────────────────────────────────────────────────
# Test keys start with sk_test_ / whsec_ ; live keys with sk_live_.
STRIPE_SECRET_KEY=sk_test_xxx
# From the Stripe CLI (`stripe listen`) locally, or the Dashboard webhook in prod.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Order notifications (Google Apps Script) ────────────────────────────────
# The webhook POSTs each paid order here; Apps Script logs the row and emails
# the owner + customer. Set BOTH in Vercel.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwVFwy4Lwhu8EC3vMQrQL_PQqepsWYCjlZwUdLsuNNDcXY895_gIv-I_mVBv-pILUWg/exec
# Shared secret checked by the Apps Script. Set the VALUE only in Vercel, never
# commit it. Leave blank here.
APPS_SCRIPT_SECRET=

# ─── Payments mode (BRIEF §3.3) ──────────────────────────────────────────────
# "stripe" (default) = hosted Stripe Checkout.
# "preorder_dm" = checkout button opens a pre-filled WhatsApp/Instagram DM instead
# (use this if the Stripe account isn't verified yet, no code change needed).
NEXT_PUBLIC_PAYMENTS_MODE=stripe
# International number WITHOUT the +, e.g. 15551234567. Only used in preorder_dm mode;
# if empty, the button falls back to opening the Instagram profile.
NEXT_PUBLIC_WHATSAPP_NUMBER=
