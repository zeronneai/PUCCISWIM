# PUCCII Swim environment
# Copy to .env.local for local dev; set the same keys in Vercel for production.

# Public site URL, no trailing slash. Used for absolute OG/metadata URLs.
# Local: http://localhost:3000   Prod: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout, payment and fulfillment are handled by Shopify. The store domain
# and variant ids live in lib/shopify.ts, so no payment secrets are needed here.
